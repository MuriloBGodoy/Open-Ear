tools/.pinterest-session.json

# saída do screenshot.mjs — regerável, e são ~3 MB de estados repetidos
.screenshots/

# as referências visuais são trabalho autoral de terceiros, baixado do Pinterest:
# usar como estudo é uma coisa, redistribuir num repositório público é outra.
# Os `sources.json` ficam, e é o que importa — cada análise nos READMEs aponta
# para o link original, que continua alcançável.
designs/**/pins/**/*.jpg

